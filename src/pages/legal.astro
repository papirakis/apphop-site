---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
---
<Base title="Legal" description="Terms of use and trademark notices for AppHop.">
  <Crumbs items={[{ label: 'Legal' }]} />
  <section class="section wrap prose">
    <h1>Legal</h1>
    <h2>Terms of use</h2>
    <p>Our apps are licensed under Apple’s standard Licensed Application End User License Agreement unless an app states otherwise.</p>
    <h2>Trademarks</h2>
    <p>Apple, iPhone and App Store are trademarks of Apple Inc., registered in the U.S. and other countries.</p>
  </section>
</Base>
