---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import AppSubnav from '../../../components/AppSubnav.astro';
import { APPS, type AppEntry } from '../../../data/apps';
import { SITE } from '../../../data/site';
import { u } from '../../../lib';
export function getStaticPaths() { return APPS.map((app) => ({ params: { slug: app.slug }, props: { app } })); }
const { app } = Astro.props as { app: AppEntry };
const p = app.privacy;
---
<Base title={`${app.name} Privacy Policy`} description={`How ${app.name} handles your data.`}>
  <Crumbs items={[{ label: 'Apps', href: 'apps/' }, { label: app.name, href: `apps/${app.slug}/` }, { label: 'Privacy' }]} />
  <div class="wrap"><AppSubnav slug={app.slug} current="privacy" /></div>
  <section class="section wrap prose">
    <h1>{app.name} privacy policy</h1>
    <p class="notice">Draft for review. This policy will be finalised against the app’s App Privacy details before App Store submission.</p>
    <p><strong>In short:</strong> {app.name} is designed to work on your iPhone. We do not sell your data, and we do not use it for advertising.</p>
    <h2>Data that stays on your device</h2>
    <ul>{p.onDevice.map((x) => <li>{x}</li>)}</ul>
    <h2>Data we may receive</h2>
    <ul>{p.collected.map((x) => <li>{x}</li>)}</ul>
    <h2>Third parties</h2>
    <ul>{p.thirdParties.map((x) => <li>{x}</li>)}</ul>
    <h2>Retention and deletion</h2>
    <p>{p.retention}</p>
    <h2>Children</h2>
    <p>{app.name} is not directed at children under 13 and does not knowingly collect their personal information.</p>
    <h2>Your rights</h2>
    <p>You can ask us what we hold about you, or ask us to delete it, by emailing <a href={`mailto:${SITE.emails.privacy}`}>{SITE.emails.privacy}</a>.</p>
    <h2>Changes</h2>
    <p>We will post any changes on this page and update the date below.</p>
    <p class="muted">Last updated: November 2026. See also the <a href={u('privacy/')}>company privacy policy</a>.</p>
  </section>
</Base>
